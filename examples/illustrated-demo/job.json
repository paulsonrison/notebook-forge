      "title": "TCP three-way handshake",
      "covers": [
        "tcp"
      ],
      "blocks": [
        {
          "type": "paragraph",
          "label": "Understand",
          "text": "A client sends SYN. The server replies with SYN and ACK, acknowledging the client sequence plus one. The client acknowledges the server SYN. This exchange establishes a TCP connection; it does not encrypt it.",
          "illustration": {
            "id": "tcp-handshake-diagram",
            "concept": "TCP three-way handshake",
            "layout": "two vertical endpoint lifelines",
            "caption": "Each endpoint sends a SYN and receives an acknowledgement before the connection is established.",
            "alt": "Three messages appear between client and server: SYN, SYN plus ACK, then ACK.",
            "topic": "tcp",
