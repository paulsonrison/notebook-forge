{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notebook Forge job",
  "type": "object",
  "required": [
    "title",
    "theme",
    "layout",
    "sources",
    "topics",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "$ref": "#/$defs/text"
    },
    "subtitle": {
      "$ref": "#/$defs/text"
    },
    "author": {
      "$ref": "#/$defs/text"
    },
    "theme": {
      "type": "object",
      "required": [
        "name",
        "confirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "notebook",
            "plain",
            "custom"
          ]
        },
        "confirmed": {
          "const": true
        },
        "palette": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "paper": {
              "$ref": "#/$defs/colour"
            },
            "ink": {
              "$ref": "#/$defs/colour"
            },
            "rule": {
              "$ref": "#/$defs/colour"
            },
            "margin": {
              "$ref": "#/$defs/colour"
            },
            "highlight": {
              "$ref": "#/$defs/colour"
            },
            "pink": {
              "$ref": "#/$defs/colour"
            },
            "mint": {
              "$ref": "#/$defs/colour"
            },
            "code": {
              "$ref": "#/$defs/colour"
            },
            "practice": {
              "$ref": "#/$defs/colour"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "custom"
              }
            }
          },
          "then": {
            "required": [
              "palette"
            ]
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "mode",
        "confirmed"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "subtopic-pages",
            "topic-pages",
            "compact",
            "custom"
          ]
        },
        "confirmed": {
          "const": true
        },
        "instructions": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "custom"
              }
            }
          },
          "then": {
            "required": [
              "instructions"
            ]
          }
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "topic",
              "text",
              "file",
              "url"
            ]
          },
          "value": {
            "$ref": "#/$defs/text"
          },
          "title": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "parent": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "covers",
          "blocks"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "block": {
      "type": "object",
      "required": [
        "type",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "bullets",
            "code",
            "callout",
            "practice"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "animation": {
          "$ref": "#/$defs/animation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "bullets"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          },
          "else": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "required": [
              "animation"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "paragraph"
              }
            }
          }
        }
      ]
    },
    "animation": {
      "type": "object",
      "required": [
        "id",
        "concept",
        "layout",
        "pattern",
        "motion_reason",
        "alt",
        "caption",
        "storyboard"
      ],
      "additionalProperties": false,
      "properties": {
        "concept": {
          "$ref": "#/$defs/text"
        },
        "layout": {
          "$ref": "#/$defs/text"
        },
        "pattern": {
          "$ref": "#/$defs/text"
        },
        "motion_reason": {
          "$ref": "#/$defs/text"
        },
        "alt": {
          "$ref": "#/$defs/text"
        },
        "caption": {
          "$ref": "#/$defs/text"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "storyboard": {
          "type": "object",
          "required": [
            "title",
            "frames"
          ],
          "additionalProperties": false,
          "properties": {
            "title": {
              "$ref": "#/$defs/text"
            },
            "frames": {
              "type": "array",
              "minItems": 2,
              "maxItems": 30,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "duration_ms",
                  "objects"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "$ref": "#/$defs/text"
                  },
                  "duration_ms": {
                    "type": "integer",
                    "minimum": 500,
                    "maximum": 3000,
                    "multipleOf": 10
                  },
                  "objects": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 80,
                    "items": {
                      "$ref": "#/$defs/primitive"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "primitive": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "rect",
            "ellipse",
            "line",
            "arrow"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "fill": {
          "$ref": "#/$defs/colour"
        },
        "background": {
          "$ref": "#/$defs/colour"
        },
        "size": {
          "type": "integer",
          "minimum": 24,
          "maximum": 48
        },
        "xy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 4
        },
        "box": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "xy",
              "text"
            ],
            "properties": {
              "xy": {
                "maxItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "rect",
                  "ellipse"
                ]
              }
            }
          },
          "then": {
            "required": [
              "box"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "line",
                  "arrow"
                ]
              }
            }
          },
          "then": {
            "required": [
              "xy"
            ],
            "properties": {
              "xy": {
                "minItems": 4
              }
            }
          }
        }
      ]
    }
  }
}
